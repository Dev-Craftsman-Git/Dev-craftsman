datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// User Management (Role Based Access Control)
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  password      String
  role          String    @default("EDITOR") // SUPER_ADMIN, ADMIN, EDITOR, VIEWER
  avatar        String?
  isActive      Boolean   @default(true)
  lastLogin     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  assignedSubmissions Submission[]
  notes               SubmissionNote[]
  activityLogs        ActivityLog[]
}

// Dynamic Forms Configuration
model FormField {
  id          String   @id @default(cuid())
  formType    String   // 'student', 'commercial'
  label       String
  name        String
  type        String   // 'text', 'email', 'tel', 'select', 'textarea', 'file', 'checkbox', 'radio'
  placeholder String?
  required    Boolean  @default(false)
  options     String?  // JSON string for select/radio options
  validation  String?  // Regex pattern
  width       String   @default("full") // 'full', 'half'
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Unified Submissions (CRM)
model Submission {
  id          String   @id @default(cuid())
  formType    String   // 'student', 'commercial'
  data        String   // JSON string containing all form fields (flexible)
  status      String   @default("NEW") // NEW, VIEWED, IN_PROGRESS, COMPLETED, ARCHIVED
  priority    String   @default("NORMAL") // LOW, NORMAL, HIGH, URGENT
  source      String?  // 'web', 'manual', 'api'
  
  // Relations
  assignedToId String?
  assignedTo   User?    @relation(fields: [assignedToId], references: [id])
  notes        SubmissionNote[]
  
  viewedAt    DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SubmissionNote {
  id           String     @id @default(cuid())
  content      String
  submissionId String
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  userId       String
  user         User       @relation(fields: [userId], references: [id])
  createdAt    DateTime   @default(now())
}



model Admin {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String   // hashed
  name      String?
  role      String   @default("ADMIN") // SUPER_ADMIN, ADMIN, EDITOR, VIEWER
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  twoFactorSecret String?
  twoFactorEnabled Boolean @default(false)
}

model PricingPlan {
  id            String    @id @default(cuid())
  type          String    // STUDENT, COMMERCIAL
  name          String
  price         Int
  originalPrice Int?
  currency      String    @default("INR")
  isPopular     Boolean   @default(false)
  isVisible     Boolean   @default(true)
  order         Int       @default(0)
  features      Feature[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Feature {
  id        String       @id @default(cuid())
  text      String
  isEnabled Boolean      @default(true)
  order     Int          @default(0)
  planId    String
  plan      PricingPlan  @relation(fields: [planId], references: [id], onDelete: Cascade)
}

model Section {
  id        String   @id @default(cuid())
  page      String   // 'home', 'pricing', ...
  name      String   // 'hero', 'stats', 'testimonials', ...
  isVisible Boolean  @default(true)
  order     Int      @default(0)
  config    String   // JSON string
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([page, name])
}



// Portfolio/Projects
model Project {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  description String
  content     String?  // Rich text or Markdown
  client      String?
  industry    String?
  tags        String   // JSON array
  thumbnail   String?
  images      String?  // JSON array of gallery images
  challenges  String?  // Rich text
  solutions   String?  // Rich text
  demoUrl     String?
  showDemo    Boolean  @default(false)
  websiteUrl  String?
  repoUrl     String?
  isFeatured  Boolean  @default(false)
  status      String   @default("DRAFT") // DRAFT, PUBLISHED
  order       Int      @default(0)
  publishedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status, order])
}

// CMS Content (Dynamic Text/Images)
model ContentBlock {
  id          String   @id @default(cuid())
  section     String   // e.g., 'home_hero', 'about_mission'
  key         String   @unique // e.g., 'home_hero_title'
  value       String   // The actual content
  type        String   // 'text', 'image', 'video', 'json'
  label       String?  // Admin facing label
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Services
model Service {
  id          String   @id @default(cuid())
  title       String
  description String
  icon        String
  features    String?  // JSON array
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Theme System
model ThemePreset {
  id          String   @id @default(cuid())
  name        String
  colors      String   // JSON: { primary, secondary, background, text... }
  config      String?  // JSON: specific particle configs etc
  activeOn    String?  // 'MONDAY', 'TUESDAY'...
  isDefault   Boolean  @default(false)
}


model ActivityLog {
  id        String   @id @default(cuid())
  action    String
  entity    String
  entityId  String?
  details   String?
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
}

model VisitorMetric {
  id           String   @id @default(cuid())
  date         DateTime @unique // YYYY-MM-DD (stored as midnight UTC)
  totalVisits  Int      @default(0)
  uniqueVisits Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
